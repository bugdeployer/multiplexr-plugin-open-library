{
  "id": "com.bugdeployer.openlibrary",
  "version": "0.1.0",
  "name": "Open Library metadata",
  "entry": "plugin.js",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "capabilities": {
    "required": [
      "ui.present",
      "settings.read",
      "settings.write"
    ],
    "optional": []
  },
  "contributions": [
    {
      "id": "com.bugdeployer.openlibrary:open",
      "family": "ui.destination",
      "title": "Open plugin",
      "handler": "plugin.open"
    },
    {
      "id": "com.bugdeployer.openlibrary:settings",
      "family": "settings.section",
      "title": "Plugin settings",
      "description": "Choose the message shown by the plugin.",
      "icon": "extension",
      "schemaVersion": 1,
      "scopes": [
        "app"
      ],
      "fields": [
        {
          "id": "com.bugdeployer.openlibrary:greeting",
          "type": "text",
          "label": "Message",
          "accessibleLabel": "Plugin message",
          "maxLength": 200,
          "default": "Hello from your plugin.",
          "scopes": [
            "app"
          ]
        }
      ]
    }
  ]
}
